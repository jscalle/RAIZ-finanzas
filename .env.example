# ============================================================================
# RAÍZ Finanzas — Environment Configuration Template (.env.example)
# Copy this file to `.env` and fill in your own credentials:
#   cp .env.example .env
# ============================================================================

# --- 1. Firebase Client Configuration (Frontend + Sync) ---
# Obtain these values in Firebase Console -> Project Settings -> Your Apps (Web)
VITE_FIREBASE_PROJECT_ID="your-firebase-project-id"
VITE_FIREBASE_API_KEY="your-firebase-web-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-firebase-project-id.firebaseapp.com"
VITE_FIREBASE_STORAGE_BUCKET="your-firebase-project-id.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="000000000000"
VITE_FIREBASE_APP_ID="1:000000000000:web:abcdef1234567890"
VITE_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

# Optional: Google OAuth Client ID for native iOS/Android Capacitor builds
VITE_GOOGLE_OAUTH_CLIENT_ID="000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com"

# Backend API URL (leave empty "" when running locally on the same port or behind Firebase Hosting rewrites,
# or set to your deployed Cloud Run URL e.g. "https://raiz-api-xxxxx.us-central1.run.app")
VITE_API_BASE_URL=""

# --- 2. Backend & AI Configuration (Server / Cloud Run) ---
# Option A: Use Google Cloud Vertex AI (Recommended for Cloud Run)
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"
VERTEX_AI_LOCATION="global"

# Option B: Or use Google AI Studio API Key directly
GEMINI_API_KEY=""

# Optional: Service Account JSON string for local Firebase Admin verification
FIREBASE_SERVICE_ACCOUNT=""

# --- 3. Telegram Bot & Webhooks Configuration ---
# Create your bot via @BotFather on Telegram and paste the token here:
TELEGRAM_BOT_TOKEN="0000000000:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Optional: Secret Bearer token for iOS Shortcuts / SMS webhook (/api/webhook/transacciones)
WEBHOOK_SECRET_TOKEN="your-custom-webhook-secret"

# Optional: Meta WhatsApp Cloud API integration
WHATSAPP_VERIFY_TOKEN="your-whatsapp-verify-token"
WHATSAPP_ACCESS_TOKEN=""
